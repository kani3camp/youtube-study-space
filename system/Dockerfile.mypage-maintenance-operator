FROM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY go.mod go.sum ./
# A digest update must keep the compiler identical to the canonical go.mod version.
RUN test "$(go env GOVERSION)" = "go$(awk '$1 == "go" { print $2; exit }' go.mod)"
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -tags timetzdata -trimpath -ldflags="-s -w" -o /out/mypage-maintenance-operator ./cmd/mypage-maintenance-operator

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
WORKDIR /app
ENV TZ=Asia/Tokyo
COPY --from=build /out/mypage-maintenance-operator /app/mypage-maintenance-operator
USER nonroot:nonroot
ENTRYPOINT ["/app/mypage-maintenance-operator"]
