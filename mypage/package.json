{
	"name": "mypage",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@10.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"engines": {
		"node": ">=24.22.1 <25"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.169.2",
		"firebase": "^12.13.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@tailwindcss/vite": "4",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"tailwindcss": "4",
		"typescript": "~6.0.2",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"overrides": {
			"@firebase/firestore>@grpc/grpc-js": "~1.13.6",
			"vite>esbuild": "~0.28.1"
		}
	}
}
