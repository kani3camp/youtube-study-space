# Source preparation only. Keep outside .github/workflows until separately approved.
name: CodeQL Advanced

on:
  push:
    branches:
      - dev
      - main
      - feature/gcp-terraform-iac
      - integration/mypage-canon-20261006
  pull_request:
    branches: ["**"]
  schedule:
    - cron: "23 4 * * 1"
  workflow_dispatch:

permissions:
  contents: read
  security-events: write
  id-token: none

concurrency:
  group: codeql-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  analyze:
    name: CodeQL
    # Second safety barrier; publishing the files alone must not allocate a runner.
    if: ${{ false }}
    uses: ./.github/workflows/codeql-analyzer.yml
    permissions:
      contents: read
      security-events: write
      id-token: none
