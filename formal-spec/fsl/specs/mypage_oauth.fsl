// 1つのOAuth認証処理を追う。LoginとSupportの目的は作成後に変わらない。
// 有効期限内か、同意した文書のバージョンが一致するか、保存したアクセス許可が有効かを真偽値で表す。
// 外部サービスによる認証・トークン発行は、分割できない保存処理と分け、外部処理中の失敗・失効を許す。
spec MyPageOAuth {
  enum Purpose { Login, Support }
  enum Status { Idle, Pending, Processing, Verified, Consumed, Failed }
  enum MintStatus { NoMint, Ready, InFlight, Delivered, Rejected }

  state {
    purpose: Purpose,
    status: Status,
    mint: MintStatus,
    unexpired: Bool,
    policy_current: Bool,
    access_allowed: Bool,
    checkpoint_current: Bool,
    maintenance_active: Bool,
    claims: Int,
    consumes: Int,
    mint_attempts: Int,
    account_written: Bool,
    receipt_written: Bool,
    rejected_after_external_mint: Bool
  }

  init {
    purpose = Login
    status = Idle
    mint = NoMint
    unexpired = true
    policy_current = true
    access_allowed = true
    checkpoint_current = true
    maintenance_active = false
    claims = 0
    consumes = 0
    mint_attempts = 0
    account_written = false
    receipt_written = false
    rejected_after_external_mint = false
  }

  action start(selected: Purpose) {
    requires status == Idle
    purpose = selected
    status = Pending
  }

  action expire() {
    requires status != Idle
    requires unexpired
    unexpired = false
  }

  action change_policy() {
    requires policy_current
    policy_current = false
  }

  // 確定前は最新の許可を読み直せる。確定後の変更は保存済みcheckpointを失効させる。
  action set_access(allowed: Bool) {
    if allowed != access_allowed {
      checkpoint_current = false
    }
    access_allowed = allowed
  }

  action set_maintenance(active: Bool) {
    maintenance_active = active
  }

  @requirement("REQ-MYPAGE-AUTH-001", "コールバックは有効期限内でstateが一致する認証処理を一度だけ確保し、競合する処理から同時に確保されないようにする")
  action claim(state_matches: Bool) {
    requires status == Pending
    requires unexpired
    requires state_matches
    requires purpose == Support or not maintenance_active
    status = Processing
    claims = claims + 1
    ensures old(unexpired) and state_matches
  }

  @requirement("REQ-MYPAGE-AUTH-002", "コールバックの処理権を確保し、チャンネルが1つだけであることを確認してから確定へ進む")
  action verify_channel(unique_channel: Bool) {
    requires status == Processing
    requires unexpired
    requires unique_channel
    requires purpose == Support or not maintenance_active
    status = Verified
    ensures old(unexpired) and unique_channel
  }

  action fail() {
    requires status == Pending or status == Processing or status == Verified
    status = Failed
  }

  @requirement("REQ-MYPAGE-AUTH-003", "ログイン確定時の認証処理の使用済み化とアカウント更新は、分割できない1つの状態遷移で一度だけ行う")
  action confirm_login(confirmation_matches: Bool) {
    requires status == Verified
    requires purpose == Login
    requires unexpired
    requires policy_current
    requires access_allowed
    requires not maintenance_active
    requires confirmation_matches
    status = Consumed
    consumes = consumes + 1
    account_written = true
    mint = Ready
    checkpoint_current = true
    ensures old(unexpired) and old(policy_current) and old(access_allowed) and confirmation_matches
  }

  @requirement("REQ-MYPAGE-AUTH-004", "サポート用の確定処理は依頼とチャンネルの対応を確認し、本人確認の証跡だけを作ってログイン権限は発行しない")
  action confirm_support(confirmation_matches: Bool, binding_matches: Bool) {
    requires status == Verified
    requires purpose == Support
    requires unexpired
    requires policy_current
    requires confirmation_matches
    requires binding_matches
    status = Consumed
    consumes = consumes + 1
    receipt_written = true
    ensures old(unexpired) and old(policy_current) and confirmation_matches and binding_matches
  }

  @requirement("REQ-MYPAGE-AUTH-005", "トークン発行は認証処理の使用済み化後に一度だけ試み、失敗した場合や結果を確認できない場合も認証処理を再利用しない")
  action attempt_mint(succeeds: Bool) {
    requires mint == Ready
    requires checkpoint_current
    requires access_allowed
    requires not maintenance_active
    mint_attempts = mint_attempts + 1
    if succeeds {
      mint = InFlight
    } else {
      mint = Rejected
    }
  }

  @requirement("REQ-MYPAGE-AUTH-006", "外部サービスでのトークン発行中にログインの許可条件が失効した場合は、生成したトークンを返さない")
  action finish_mint() {
    requires mint == InFlight
    if access_allowed and checkpoint_current {
      mint = Delivered
    } else {
      mint = Rejected
      rejected_after_external_mint = true
    }
    ensures mint == Delivered => (old(access_allowed) and old(checkpoint_current))
  }

  @requirement("REQ-MYPAGE-AUTH-001", "コールバックは有効期限内でstateが一致する認証処理を一度だけ確保し、競合する処理から同時に確保されないようにする")
  invariant SingleClaimAndConsume {
    0 <= consumes and consumes <= claims and claims <= 1
  }

  @requirement("REQ-MYPAGE-AUTH-003", "ログイン確定時の認証処理の使用済み化とアカウント更新は、分割できない1つの状態遷移で一度だけ行う")
  invariant AccountRequiresConsumedLogin {
    account_written == (status == Consumed and purpose == Login)
  }

  @requirement("REQ-MYPAGE-AUTH-004", "サポート用の確定処理は依頼とチャンネルの対応を確認し、本人確認の証跡だけを作ってログイン権限は発行しない")
  invariant SupportCannotMintOrWriteAccount {
    purpose == Support => (mint == NoMint and mint_attempts == 0 and not account_written)
  }

  invariant ReceiptRequiresConsumedSupport {
    receipt_written == (status == Consumed and purpose == Support)
  }

  @requirement("REQ-MYPAGE-AUTH-005", "トークン発行は認証処理の使用済み化後に一度だけ試み、失敗した場合や結果を確認できない場合も認証処理を再利用しない")
  invariant MintRequiresConsume {
    0 <= mint_attempts and mint_attempts <= consumes
  }

  @requirement("REQ-MYPAGE-AUTH-004", "サポート用の確定処理は依頼とチャンネルの対応を確認し、本人確認の証跡だけを作ってログイン権限は発行しない")
  trans PurposeNeverChangesAfterCreation {
    old(status) != Idle => purpose == old(purpose)
  }

  trans ConsumedCheckpointNeverRenews {
    old(status) == Consumed and not old(checkpoint_current) => not checkpoint_current
  }

  trans ConsumedNeverReopens {
    old(status) == Consumed => status == Consumed
  }

  // 失敗や使用済み化後の停止は、意図した終了状態として扱う。再試行には別の認証処理が必要。
  terminal {
    status == Failed or (status == Consumed and
      (mint == NoMint or mint == Delivered or mint == Rejected or
       (mint == Ready and not checkpoint_current)))
  }

  reachable LoginTokenCanBeDelivered { mint == Delivered }
  reachable FailedMintStaysConsumed { mint == Rejected and status == Consumed }
  reachable SupportProofSurvivesLoginRestriction {
    receipt_written and not access_allowed
  }
  reachable VerifiedLoginCanWaitForAccess { status == Verified and purpose == Login and not access_allowed }
  reachable InFlightMintCanBeRejected {
    rejected_after_external_mint and mint == Rejected and not access_allowed
  }
}
