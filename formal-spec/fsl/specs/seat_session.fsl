// SeatDoc の Work / Break 状態機械を、検証可能な有限モデルへ射影する。
// 文字列、Firestore 表現、JST 日付跨ぎなどは意図的にモデル外とする。
// FSL の action は RHS を同じ pre-state から読み、更新を同時に commit する。
spec SeatSession {
  type Clock = 0..4
  type Duration = 1..3
  type MaxDuration = 1..4

  enum Mode { Work, Break }

  state {
    mode: Mode,
    now: Clock,
    until: Int,
    current_state_started_at: Clock,
    current_state_until: Int,
    current_segment_started_at: Clock,
    cumulative_work: Int
  }

  init {
    mode = Work
    now = 0
    until = 3
    current_state_started_at = 0
    current_state_until = 3
    current_segment_started_at = 0
    cumulative_work = 0
  }

  // 検証ハーネス上の時間経過。Go のドメインメソッドには対応しない。
  action tick() {
    requires now < 4
    now = now + 1
  }

  @requirement("REQ-SEAT-001", "休憩開始は Work 中だけ許可する")
  action start_break(duration: Duration) {
    requires mode == Work
    cumulative_work = cumulative_work + (now - current_state_started_at)
    mode = Break
    current_state_started_at = now
    current_state_until = now + duration
    current_segment_started_at = now
    if now + duration > until {
      until = now + duration
    }
  }

  @requirement("REQ-SEAT-002", "作業再開は Break 中だけ許可する")
  action resume_work() {
    requires mode == Break
    mode = Work
    current_state_started_at = now
    current_state_until = until
    current_segment_started_at = now
  }

  @requirement("REQ-SEAT-003", "Work 中の作業時間変更では自動退室時刻と状態終了時刻を同期する")
  action set_work_duration(duration: Duration) {
    requires mode == Work
    until = now + duration
    current_state_until = now + duration
  }

  @requirement("REQ-SEAT-004", "Work 延長は現在時刻からの最大残り時間を超えない")
  action extend_work_duration(add: Duration, max_remaining: MaxDuration) {
    requires mode == Work
    if until + add - now > max_remaining {
      until = now + max_remaining
      current_state_until = now + max_remaining
    } else {
      until = until + add
      current_state_until = until + add
    }
  }

  @requirement("REQ-SEAT-005", "Break 延長は休憩開始からの上限を守り、必要なら自動退室時刻も延長する")
  action extend_break_duration(add: Duration, max_break_duration: MaxDuration) {
    requires mode == Break
    if current_state_until + add - current_state_started_at > max_break_duration {
      current_state_until = current_state_started_at + max_break_duration
      if current_state_started_at + max_break_duration > until {
        until = current_state_started_at + max_break_duration
      }
    } else {
      current_state_until = current_state_until + add
      if current_state_until + add > until {
        until = current_state_until + add
      }
    }
  }

  @requirement("REQ-SEAT-005", "休憩終了時刻は自動退室時刻を超えない")
  @kind("safety")
  invariant BreakEndsBeforeExit {
    current_state_until <= until
  }

  @requirement("REQ-SEAT-003", "Work 中は状態終了時刻と自動退室時刻が一致する")
  @kind("safety")
  invariant WorkDeadlineMatchesExit {
    mode == Work => current_state_until == until
  }

  @kind("safety")
  invariant StateStartNotInFuture {
    current_state_started_at <= now
  }

  @kind("safety")
  invariant SegmentStartNotInFuture {
    current_segment_started_at <= now
  }

  @kind("safety")
  invariant CumulativeWorkNeverNegative {
    cumulative_work >= 0
  }

  reachable BreakModeIsReachable {
    mode == Break
  }

  reachable WorkAfterBreakIsReachable {
    mode == Work and cumulative_work > 0
  }
}
