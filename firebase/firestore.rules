rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedMonitor() {
      return request.auth != null
        && request.auth.token.monitor_reader == true
        && exists(/databases/$(database)/documents/_monitor-readers/$(request.auth.uid))
        && get(/databases/$(database)/documents/_monitor-readers/$(request.auth.uid)).data.enabled == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // この許可リストはServer/Admin SDKがIAM権限で管理する。
    // ブラウザから許可済みmonitor UIDの列挙・参照・変更を許可しない。
    match /_monitor-readers/{uid} {
      allow read, write: if false;
    }

    match /seats/{seat} {
      allow read: if isAuthorizedMonitor();
      allow write: if false;
    }

    match /member-seats/{seat} {
      allow read: if isAuthorizedMonitor();
      allow write: if false;
    }

    match /config/constants {
      allow read: if isAuthorizedMonitor();
      allow write: if false;
    }

    match /config/{doc} {
      allow read, write: if false;
    }

    match /menu/{doc} {
      allow read: if isAuthorizedMonitor();
      allow write: if false;
    }

    match /work-name-trend/{doc} {
      allow read: if isAuthorizedMonitor();
      allow write: if false;
    }
  }
}
